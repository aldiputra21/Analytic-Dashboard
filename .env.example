# ============================================================
# Corporate Finance Dashboard (CFD) — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# --- Database (PostgreSQL via Drizzle ORM) ---
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# --- JWT Authentication ---
# REQUIRED: Change this to a strong random secret in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
FRS_JWT_SECRET=change-me-to-a-strong-random-secret-in-production
FRS_JWT_EXPIRES_IN=30m
FRS_KEEP_ALIVE_INTERVAL_MS=15000

# --- Backup & Recovery ---
# Directory where encrypted backups are stored
BACKUP_LOCATION=./backups
# AES-256 encryption key for backups (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=change-me-to-a-64-char-hex-string-for-aes256-encryption

# --- SMTP Email (optional — used for scheduled reports) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=reports@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com

# --- Cache ---
# TTL in milliseconds for ratio calculation cache (default: 5 minutes)
CACHE_TTL=300000

# --- Rate Limiting ---
# Global limit (e.g., all /api routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Auth specific limit (stricter)
RATE_LIMIT_AUTH_MAX=50

# --- Gemini AI (optional — used for AI-powered insights) ---
GEMINI_API_KEY=
