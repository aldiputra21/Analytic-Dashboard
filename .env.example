# ============================================================
# Corporate Finance Dashboard (CFD) — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# --- Database (PostgreSQL via Drizzle ORM) ---
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
DB_POOL_MAX=10

# Read-only database connection used exclusively for report query execution.
# Recommended: point this to a PostgreSQL user with SELECT-only privileges,
# or a read replica, to prevent report queries from affecting write traffic.
# If omitted, the system falls back to DATABASE_URL with a 30-second
# statement_timeout applied automatically on each connection.
# DATABASE_READONLY_URL=postgresql://readonly_user:password@host:port/database?sslmode=require

# --- JWT Authentication ---
# REQUIRED: Change this to a strong random secret in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
FRS_JWT_SECRET=change-me-to-a-strong-random-secret-in-production
FRS_JWT_EXPIRES_IN=30m
FRS_KEEP_ALIVE_INTERVAL_MS=15000

# --- Backup & Recovery ---
# Directory where encrypted backups are stored
BACKUP_LOCATION=./backups
# AES-256 encryption key for backups (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=change-me-to-a-64-char-hex-string-for-aes256-encryption

# --- SMTP Email (optional — used for scheduled reports) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=reports@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=no-reply@example.com

# --- Cache ---
# TTL in milliseconds for ratio calculation cache (default: 5 minutes)
CACHE_TTL=300000
# Cache-Control max-age for static assets in production (default: 1 day in ms)
STATIC_CACHE_MAX_AGE=86400000
# Dashboard Caching (ms) - Default 5 minutes
VITE_DASHBOARD_STALE_TIME=300000

# --- Rate Limiting ---
# Set any limit to 0 to disable it entirely (unlimited) — useful for debugging.
#
# Global limit — applies to all /api routes
# Key: per USER ID (authenticated) or per socket IP (unauthenticated/public endpoints)
# This means users in the same office (shared NAT IP) each get their own bucket.
# Window: 15 minutes, default 500 requests per window per user. 0 = unlimited.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Auth limit — TWO chained limiters protect login endpoints:
#
#   RATE_LIMIT_AUTH_MAX     = per-USERNAME limit (stops account brute force)
#                             10 failed attempts per account per 15 min is enough
#                             to stop dictionary attacks without locking out real users.
#                             0 = unlimited (disables this limiter).
#
#   RATE_LIMIT_AUTH_IP_MAX  = per-IP limit (stops credential stuffing from one source)
#                             Set high enough so an office with many users logging in
#                             concurrently is never blocked (e.g. 200 = ~13 users/min).
#                             0 = unlimited (disables this limiter).
#
RATE_LIMIT_AUTH_MAX=10

# Login per-IP — sesuaikan dengan ukuran kantor:
#   <30 user  → 200 (default)
#   30-50 user → 500
#   >50 user   → 1000
RATE_LIMIT_AUTH_IP_MAX=200

# Query execution limit — applies to test-query and schema endpoints
# Key: per USER ID — prevents a single user from hammering the DB with heavy queries.
# Separate shorter window (default: 1 minute) to allow active development
# while still preventing abuse. 0 = unlimited.
RATE_LIMIT_QUERY_WINDOW_MS=60000
RATE_LIMIT_QUERY_MAX=20

# Public auth endpoints limit — applies to: forgot-password, validate-activation-token,
# activate-account, validate-reset-token, reset-password-new.
# Uses DUAL key to cover both attack vectors:
#
#   RATE_LIMIT_PUBLIC_EMAIL_MAX  = per-email/identifier limit
#                                  Prevents spamming one account's inbox or locking out
#                                  a user's reset flow. NAT-safe: each account gets its
#                                  own bucket regardless of shared office IP.
#                                  5 attempts/hour is sufficient for any legitimate user.
#                                  0 = unlimited.
#
#   RATE_LIMIT_PUBLIC_IP_MAX     = per-IP backstop
#                                  Stops one source from cycling through many accounts.
#                                  30/hour works for a typical office (multiple users
#                                  activating or resetting passwords on the same day).
#                                  0 = unlimited.
#
RATE_LIMIT_PUBLIC_WINDOW_MS=3600000
RATE_LIMIT_PUBLIC_EMAIL_MAX=5
RATE_LIMIT_PUBLIC_IP_MAX=30

# --- Gemini AI (optional — used for AI-powered insights) ---
GEMINI_API_KEY=

# --- PostgreSQL (Docker Compose — only needed for self-hosted production) ---
# These are used by docker-compose.yml to spin up the PostgreSQL container.
# DATABASE_URL above is auto-overridden by docker-compose to use the internal service.
# POSTGRES_USER and POSTGRES_DB default to cfd_user / cfd_db if omitted.
# POSTGRES_PASSWORD is required — setup.sh generates this automatically.
POSTGRES_USER=cfd_user
POSTGRES_DB=cfd_db
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
